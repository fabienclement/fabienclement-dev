{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "42rem",
			"wideSize": "72rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "fond", "name": "Fond", "color": "#ffffff" },
				{ "slug": "texte", "name": "Texte", "color": "#1a1a1a" },
				{ "slug": "accent", "name": "Accent", "color": "#0b5cad" },
				{ "slug": "discret", "name": "Discret", "color": "#f2f2f2" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "systeme",
					"name": "Police système",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "petit", "name": "Petit", "size": "0.875rem" },
				{ "slug": "normal", "name": "Normal", "size": "1.125rem" },
				{ "slug": "grand", "name": "Grand", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "titre", "name": "Titre", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "Petit", "size": "0.5rem" },
				{ "slug": "40", "name": "Moyen", "size": "1rem" },
				{ "slug": "60", "name": "Grand", "size": "2rem" },
				{ "slug": "80", "name": "Très grand", "size": "4rem" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--fond)",
			"text": "var(--wp--preset--color--texte)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--systeme)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			},
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":focus": {
					"outline": { "color": "var(--wp--preset--color--accent)", "style": "solid", "width": "3px", "offset": "2px" }
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--titre)", "lineHeight": "1.2" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--grand)", "lineHeight": "1.3" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	]
}
